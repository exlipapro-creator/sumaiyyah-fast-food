# Runtime
PORT=3000
NODE_ENV=production

# Persistence Paths (Render Persistent Disk mounted at /data)
DROIDBOT_DB_PATH=/data/app.db
DROIDBOT_UPLOADS_PATH=/data/uploads

# Security & Session
DROIDBOT_SESSION_SECRET=
DROIDBOT_COOKIE_SECURE=true

# Initial Production Manager Bootstrap (Used once on first boot when DB has 0 users)
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_PASSWORD=
INITIAL_MANAGER_NAME=Operations Manager
