# Copy to .env.local for local development (git-ignored). Not required for
# `npm run dev` — sensible defaults apply — but set these explicitly for
# anything resembling production.

# HTTP port to listen on.
PORT=3000

# Path to the SQLite database file. Defaults to ./data/app.db.
DROIDBOT_DB_PATH=./data/app.db

# Directory where uploaded menu-item images are stored. Defaults to a
# subdirectory next to the database (./data/uploads) so both persist together
# on the same Docker volume.
DROIDBOT_UPLOADS_PATH=./data/uploads

# JWT signing secret, minimum 16 characters. REQUIRED in production — without
# it the app either falls back to a well-known dev secret (non-production) or
# generates a random per-process secret (production), which invalidates
# sessions on every restart and breaks multi-instance deployments.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DROIDBOT_SESSION_SECRET=

# Set to "true" to mark the session cookie Secure (requires HTTPS). Leave
# unset for local HTTP development.
DROIDBOT_COOKIE_SECURE=
